<?xml version="1.0" encoding="UTF-8"?>
<!-- SBS file association installed to /usr/share/mime/packages/ -->
<!-- update-mime-database runs on install -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-sbs+xml">
    <comment>SBS package</comment>
    <sub-class-of type="application/xml"/>
    <icon name="ai.storyteller.materialcraft"/>
    <glob pattern="*.sbs" weight="60"/>
  </mime-type>
</mime-info>
