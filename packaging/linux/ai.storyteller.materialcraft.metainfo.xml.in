<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.materialcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>MaterialCraft</name>
  <summary>Design procedural PBR materials with node graphs</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      MaterialCraft is an open-source, native node-based material designer: build tileable PBR
      materials from noises, patterns and filters in a node graph, preview them live in 2D and 3D,
      and export the texture maps for any engine.
    </p>
    <ul>
      <li>Hundreds of procedural nodes: noises, patterns, adjustments, blurs, warps, normal and height tools</li>
      <li>Live 2D and 3D previews with physically based shading</li>
      <li>Export base color, normal, roughness, metallic, height and ambient occlusion maps as PNG, EXR, TGA, JPEG or TIFF; save packages as .sbs</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.materialcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.materialcraft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/materialcraft</url>
  <url type="bugtracker">https://github.com/storytold/materialcraft/issues</url>
  <url type="help">https://github.com/storytold/materialcraft</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Graphics</category>
    <category>3DGraphics</category>
  </categories>
  <keywords>
    <keyword>procedural</keyword>
    <keyword>material</keyword>
    <keyword>node graph</keyword>
    <keyword>pbr</keyword>
    <keyword>3d</keyword>
    <keyword>mesh</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#a8e3ef</color>
    <color type="primary" scheme_preference="dark">#0e5f72</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>materialcraft</binary>
    <mediatype>application/x-sbs+xml</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
